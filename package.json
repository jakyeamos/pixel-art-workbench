{
  "name": "pixel-art-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first, region-aware pixel-art underpainting workbench and CLI.",
  "bin": {
    "pixel-workbench": "dist-cli/index.js"
  },
  "engines": {
    "node": "22.14.0",
    "pnpm": "11.21.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && tsup src/cli/index.ts --format esm --dts --out-dir dist-cli --clean",
    "cli": "tsx src/cli/index.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:dead-code": "knip",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "0.35.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/coverage-v8": "4.0.13",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "knip": "5.73.4",
    "prettier": "3.6.2",
    "tsup": "8.5.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "7.2.4",
    "vitest": "4.0.13"
  }
}
